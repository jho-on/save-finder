# Copy to .env and load it before running commands, for example:
#   set -a; . ./.env; set +a
# All variables are optional; defaults come from config/settings.toml.

# Root of the repository (used to resolve relative paths).
# SAVE_FINDER_ROOT=/path/to/save-finder

# Alternative settings file.
# SAVE_FINDER_CONFIG=config/settings.toml

# Override the database URL (SQLite by default).
# SAVE_FINDER_DB_URL=sqlite:///data/save-finder.db

# Override the data directory (database, thumbnails and temp media live below it).
# SAVE_FINDER_DATA_DIR=data

# Override the taxonomy file.
# SAVE_FINDER_TAXONOMY=config/taxonomy.yaml
