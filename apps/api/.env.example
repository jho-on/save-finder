# --- Obrigatório ---
# Postgres local via Docker (make dev-db). Em produção, aponte para o Postgres
DATABASE_URL=

# --- Opcionais ---
# Porta HTTP
PORT=8080
# debug | info | warn | error
LOG_LEVEL=debug
# json | text — texto para dev; json em produção
LOG_FORMAT=text
# false em dev (http://localhost sem TLS); true atrás de HTTPS
COOKIE_SECURE=false
# true somente atrás de um reverse proxy confiável (usa X-Forwarded-For)
TRUST_PROXY=false
