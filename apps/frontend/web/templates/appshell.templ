package templates

templ AppShell() {
	<!DOCTYPE html>
	<html lang="pt-BR" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Biblioteca · SaveFinder</title>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/vendor/libsodium.js" defer></script>
			<script src="/static/vendor/libsodium-wrappers.js" defer></script>
			<script src="/static/vendor/hash-wasm-argon2.js" defer></script>
			<script src="/static/app.js" defer></script>
			<script src="/static/library.js" defer></script>
		</head>
		<body data-page="app" class="app">
			<header class="appbar">
				<div class="appbar-group">
					<span class="brand-name">SaveFinder</span>
					<nav class="appnav" id="app-nav" hidden>
						<a href="#/biblioteca" data-nav="biblioteca">Biblioteca</a>
						<a href="#/tags" data-nav="tags">Tags</a>
					</nav>
				</div>
				<div class="appbar-group appbar-end">
					<span class="app-user" id="app-username" hidden></span>
					<a class="appbar-link" href="/change-password" id="app-change-password" hidden>Trocar senha</a>
					<form data-form="logout" class="logout-form" id="app-logout" hidden>
						<button class="button button-secondary button-small" type="submit" data-submit>Sair</button>
					</form>
					<button type="button" class="theme-toggle" data-theme-toggle>Trocar tema</button>
				</div>
			</header>
			<main class="app-main" id="app-root" aria-live="polite">
				<p class="app-loading">Carregando…</p>
			</main>
			<div class="app-toast" id="app-toast" role="status" aria-live="polite" hidden></div>
		</body>
	</html>
}
